{
  "name": "@jagreehal/stamp",
  "version": "0.6.1",
  "description": "Approve-first PR reviewer: deterministic gates, then a scoped LLM review, then a real GitHub approval.",
  "license": "MIT",
  "repository": "github:jagreehal/stamp",
  "type": "module",
  "bin": {
    "stamp": "./src/cli.ts"
  },
  "files": [
    "src",
    "!src/*.test.ts",
    ".stamp",
    "templates",
    "AGENTS.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "bun": ">=1.2",
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "review": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun test",
    "lint": "oxlint src",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run docs:check && bun run --cwd docs build && bun docs/scripts/check-built.ts",
    "docs:check": "bun docs/scripts/check.ts",
    "docs:preview": "bun run --cwd docs preview"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.118",
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/groq": "4.0.63",
    "@ai-sdk/mistral": "4.0.66",
    "@ai-sdk/openai": "4.0.96",
    "@ai-sdk/openai-compatible": "3.0.71",
    "@aws-sdk/credential-provider-node": "^3.972.86",
    "ai": "7.0.143",
    "autotel": "8.2.1",
    "autotel-bedrock": "2.0.1",
    "autotel-genai": "0.16.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@oxlint/plugins": "1.88.0",
    "@types/bun": "^1.4.3",
    "executable-stories-bun": "^0.1.0",
    "oxlint": "1.88.0",
    "typescript": "^7.0.2"
  }
}
