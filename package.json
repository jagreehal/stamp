{
  "name": "@jagreehal/stamp",
  "version": "0.1.0",
  "description": "Approve-first PR reviewer: deterministic gates, then a scoped LLM review, then a real GitHub approval.",
  "license": "MIT",
  "repository": "github:jagreehal/stamp",
  "type": "module",
  "bin": {
    "stamp": "./src/cli.ts"
  },
  "files": [
    "src",
    "!src/*.test.ts",
    ".stamp",
    "templates",
    "AGENTS.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "bun": ">=1.2",
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "review": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun test",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.109",
    "@ai-sdk/anthropic": "4.0.75",
    "@ai-sdk/openai": "4.0.87",
    "@ai-sdk/openai-compatible": "3.0.65",
    "ai": "7.0.131",
    "autotel": "8.0.0",
    "autotel-bedrock": "2.0.0",
    "autotel-genai": "0.15.3",
    "yaml": "^2.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "^1.2.0",
    "oxlint": "1.78.0",
    "typescript": "^5.7.0"
  }
}
